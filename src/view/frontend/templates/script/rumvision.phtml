<?php

declare(strict_types=1);

/** @var Template $block */
/** @var SecureHtmlRenderer $secureRenderer */

use Elgentos\Rumvision\ViewModel\Rumvision;
use Magento\Framework\View\Element\Template;
use Magento\Framework\View\Helper\SecureHtmlRenderer;

/** @var Rumvision $viewModel */
$viewModel = $block->getData('rumvision_view_model');
if (! $viewModel->shouldIncludeScript()) {
    return;
}

$trackingId = $viewModel->getTrackingId();
$hostName = $viewModel->getHostName();

$script = <<<JS
window.rumv = window.rumv || function() { (window.rumv.q = window.rumv.q || []).push(arguments) };
(function(rum, vi,si,on) {
    var s = JSON.parse( sessionStorage.getItem('rumv') || '{"pageviews":0}' ); s.pageviews++;
    if ( s.urls && s.regex && ( s.page = eval('('+s.regex+')')( s.urls, vi.location.pathname ) ) && !s.page.type ) {
        return sessionStorage.setItem('rumv', JSON.stringify( s ) );
    }

    vi.rumv.storage = s;
    var head = si.querySelector('head'), js = si.createElement('script');
    js.src = 'https://d5yoctgpv4cpx.cloudfront.net/'+rum+'/v5-'+vi.location.hostname+'.js';
    head.appendChild(js);
})( '$trackingId', window, document, '$hostName' );
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>
